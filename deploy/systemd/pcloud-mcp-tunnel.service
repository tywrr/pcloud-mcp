# Connects this machine to Cloudflare as the connector of a remotely-managed Cloudflare Tunnel,
# so the core Worker's Workers VPC binding can reach the WebDAV server on 127.0.0.1:8080. The
# connection is outbound only: no port is opened here, and the tunnel has no public hostname.
#
# Install (docs/setup.md, step 5), after pcloud-mcp-webdav.service:
#   systemctl --user enable --now pcloud-mcp-tunnel
#
# ~/.config/pcloud-mcp/tunnel-token (mode 600) holds the tunnel token from the dashboard: the
# long eyJ... string in the install command it shows. Anyone with it can run this tunnel.

[Unit]
Description=pcloud-mcp: Cloudflare Tunnel for the WebDAV server
Documentation=https://github.com/tywrr/pcloud-mcp/blob/main/docs/setup.md
Wants=pcloud-mcp-webdav.service
After=pcloud-mcp-webdav.service

[Service]
Type=simple
# --protocol quic: with the default "auto", cloudflared falls back to http2 when UDP is blocked,
# and Workers VPC doesn't work over http2. Failing loudly beats a tunnel that looks healthy.
# Workers VPC needs cloudflared 2025.7.0 or later (--token-file alone needs 2025.4.0). Adjust the
# path if it isn't from pacman.
ExecStart=/usr/bin/cloudflared tunnel --no-autoupdate --protocol quic run --token-file %h/.config/pcloud-mcp/tunnel-token
Restart=on-failure
RestartSec=10
NoNewPrivileges=yes

[Install]
WantedBy=default.target
